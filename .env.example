# Firebase web app (Authentication + Firestore + optional Analytics)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# GitHub OAuth App (optional “Connect GitHub” button)
# Authorization callback URL: http://127.0.0.1:8791/callback
# Use the same Client ID / Secret in Firebase Auth → GitHub provider
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# After deploy: Cloud Function URL that exchanges the GitHub code (keeps the secret off the app)
# Local PostgreSQL database created on this machine
RAG_DATABASE_URL=postgresql://khriseanstewart@127.0.0.1:5432/rowe

# RAG gateway: OmniRoute is preferred when configured; OpenRouter is the fallback.
# OpenRouter prefers OPENROUTER_CHAT_MODEL (use openrouter/free with no credits).
# OmniRoute prefers RAG_CHAT_MODEL.
RAG_AI_GATEWAY=omniroute
RAG_CHAT_MODEL=openai/gpt-4o-mini
RAG_OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
RAG_OMNIROUTE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=openrouter/free
RAG_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
RAG_EMBEDDING_MODEL=openai/text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
RAG_COMPRESSION=safe

# Optional GitHub App (preferred when set; otherwise Settings OAuth/PAT)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_INSTALLATION_ID=
